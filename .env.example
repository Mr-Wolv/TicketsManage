# TicketsManage local configuration
# Copy this file to .env and fill in your values.
# Do not commit real secrets to version control.

# Server binding (defaults are safe for local use)
# HOST=127.0.0.1
# PORT=5178

# Data directory override (optional)
# TICKETS_DATA_DIR=

# Discord application credentials (OAuth client ID/secret for bot admin login)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Session signing secret (random string)
# TICKETS_SECRET=

# Skip opening the browser on startup (useful for services/CI)
# TICKETS_NO_OPEN=1

# Skip background dashboard session probe on startup
# TICKETS_NO_PROBE=1
