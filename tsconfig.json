{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",

    "module": "commonjs",
    "target": "es2020",

    "sourceMap": true,
    "declaration": true,

    "strict": true,

    "esModuleInterop": true,
    "skipLibCheck": true,

    "types": ["node"],

    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true
  }
}
